# BOT Chain testnet only. Never put a mainnet or real-value key in this file.
# This file is an example; the real one is gitignored.

# Funded BOT Chain testnet key, 0x-prefixed.
# Claim gas at https://faucet.botchain.ai/basic (10 tBOT per address per 24h).
PRIVATE_KEY=

# JSON-RPC. Testnet 968, mainnet 677.
RPC_URL=https://rpc.bohr.life

# Optional second wallet. The deploy script funds it and marks it eligible, so
# a reviewer can transact without going through the faucet.
GUEST_ADDRESS=

# Optional. Defaults to 90 days from deployment.
MATURITY=
